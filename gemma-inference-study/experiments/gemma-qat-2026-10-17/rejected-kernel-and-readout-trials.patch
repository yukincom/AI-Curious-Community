+// Gemma has adjacent independent weighted norms for shared MLP and routed experts.
+// Treating both patterns as a single pack hides parallelism from the reorder pass.
+static bool check_independent_norm_packs() {
+    ggml_context * ctx = graph_ctx();
+    ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_k, n_rows);
+    ggml_tensor * a = ggml_rms_norm(ctx, x, norm_eps);
+    ggml_tensor * aw = ggml_mul(ctx, a, ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_k));
+    ggml_tensor * b = ggml_rms_norm(ctx, x, norm_eps);
+    ggml_tensor * bw = ggml_mul(ctx, b, ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_k));
+    ggml_cgraph * graph = ggml_new_graph(ctx);
+    expand_all(graph, { aw, bw });
+    const bool separate = ggml_metal_fusion_max(graph, node_index(graph, a)) == 2 &&
+                          ggml_metal_fusion_max(graph, node_index(graph, b)) == 2;
+    ggml_graph_optimize(graph);
+    const bool intact = encoded_in_a_row(graph, { a, aw }) && encoded_in_a_row(graph, { b, bw });
+    std::printf("independent Gemma norms: separate packs %d, intact fusions %d: %s\n",
+        separate, intact, separate && intact ? "OK" : "FAIL");
+    ggml_free(ctx);
+    return separate && intact;
+}
