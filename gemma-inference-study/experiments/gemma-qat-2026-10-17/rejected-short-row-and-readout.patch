+                            ggml_reshape_2d(ctx0, exact, 1, n_candidates), idx);
+        logits = ggml_reshape_2d(ctx0, full, n_vocab, 1);
+    } else {
+        logits = build_lora_mm(model.output, cur);
+    }
     cb(logits, "result_output", -1);
