 void ggml_metal_encoder_free(ggml_metal_encoder_t encoder) {
+    if (encoder->profile_samples) {
+        id<MTLCounterSampleBuffer> samples = encoder->profile_samples;
+        NSArray * labels = encoder->profile_labels;
+        [encoder->profile_cmd addCompletedHandler:^(id<MTLCommandBuffer> cb) {
+            @autoreleasepool {
+                if (cb.status == MTLCommandBufferStatusCompleted && labels.count) {
+                    NSData * data = [samples resolveCounterRange:NSMakeRange(0, 2*labels.count)];
+                    if (data.length >= 2*labels.count*sizeof(MTLCounterResultTimestamp)) {
+                        const MTLCounterResultTimestamp * values = data.bytes;
+                        NSMutableDictionary * sums = [NSMutableDictionary dictionary];
+                        NSMutableDictionary * counts = [NSMutableDictionary dictionary];
+                        for (NSUInteger i = 0; i < labels.count; ++i) {
+                            uint64_t a = values[2*i].timestamp, b = values[2*i+1].timestamp;
+                            if (a == MTLCounterErrorValue || b == MTLCounterErrorValue || b < a) continue;
+                            NSString * label = labels[i];
+                            sums[label] = @([sums[label] unsignedLongLongValue] + b-a);
+                            counts[label] = @([counts[label] unsignedLongLongValue] + 1);
+                        }
+                        for (NSString * label in sums) {
+                            fprintf(stderr, "op-timing: key=%s count=%llu gpu_ns=%llu\n", label.UTF8String,
+                                    [counts[label] unsignedLongLongValue], [sums[label] unsignedLongLongValue]);
+                        }
+                    }
+                }
+                [samples release];
+                [labels release];
+            }
+        }];
+    }
     [encoder->obj release];
     free(encoder);
 }
