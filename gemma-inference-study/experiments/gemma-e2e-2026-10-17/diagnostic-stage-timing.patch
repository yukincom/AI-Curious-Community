 struct ggml_metal_encoder {
     id<MTLComputeCommandEncoder> obj;
+    // Opt-in diagnostic: encoder boundaries serialize operations, so these
+    // measurements locate expensive operations, not normal inference throughput.
+    id<MTLCommandBuffer> profile_cmd;
+    id<MTLCounterSampleBuffer> profile_samples;
+    NSMutableArray * profile_labels;
+    bool profile_concurrent;
 };

+static id<MTLComputeCommandEncoder> ggml_metal_profile_encoder(ggml_metal_encoder_t e, NSUInteger index) {
+    MTLComputePassDescriptor * desc = [MTLComputePassDescriptor computePassDescriptor];
+    desc.dispatchType = e->profile_concurrent ? MTLDispatchTypeConcurrent : MTLDispatchTypeSerial;
+    desc.sampleBufferAttachments[0].sampleBuffer = e->profile_samples;
+    desc.sampleBufferAttachments[0].startOfEncoderSampleIndex = 2*index;
+    desc.sampleBufferAttachments[0].endOfEncoderSampleIndex = 2*index + 1;
+    return [e->profile_cmd computeCommandEncoderWithDescriptor:desc];
+}
+
+void ggml_metal_encoder_profile_begin(ggml_metal_encoder_t e, const char * key) {
+    if (!e->profile_samples) return;
+    if (e->profile_labels.count >= 2048) GGML_ABORT("Metal diagnostic sample capacity exceeded");
+    if (e->profile_labels.count) {
+        [e->obj endEncoding];
+        [e->obj release];
+        e->obj = [ggml_metal_profile_encoder(e, e->profile_labels.count) retain];
+    }
+    [e->profile_labels addObject:[NSString stringWithUTF8String:key]];
+}
